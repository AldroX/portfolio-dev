<section class="relative flex min-h-screen items-center overflow-hidden" style="min-height: 100svh">
  <!-- Green glow background -->
  <div class="absolute inset-0 -z-10" aria-hidden="true">
    <div class="hero-gradient-wash" />
    <div class="hero-glow animate-glow-pulse" />
    <div class="hero-glow-secondary" />
  </div>

  <div class="mx-auto w-full max-w-6xl px-4 py-28 sm:px-6">
    <div class="grid items-center gap-14 lg:grid-cols-[1.15fr_0.85fr] lg:gap-10">
      <!-- Text content -->
      <div class="text-center lg:text-left">
        <!-- Availability pill -->
        <div
          class="hero-reveal inline-flex items-center gap-2.5 rounded-full border border-border bg-surface/70 px-4 py-1.5 text-sm text-foreground-secondary backdrop-blur"
          style="--d: 0ms"
        >
          <span class="relative flex size-2">
            <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-mint opacity-60"></span>
            <span class="relative inline-flex size-2 rounded-full bg-mint"></span>
          </span>
          Disponible para trabajar
        </div>

        <h1
          class="hero-reveal mt-6 text-[clamp(2.75rem,7vw,4.5rem)] font-bold leading-[1.05] tracking-[-0.04em] text-foreground"
          style="--d: 120ms"
        >
          Hola, soy <span class="gradient-text">Alejandro Yero</span>
        </h1>

        <p
          class="hero-reveal mx-auto mt-6 max-w-xl text-lg leading-relaxed text-foreground-secondary md:text-xl lg:mx-0"
          style="--d: 240ms"
        >
          <strong class="font-semibold text-foreground">Ingeniero en Ciencias Informáticas</strong> full-stack con énfasis en frontend.
          Más de 2 años diseñando soluciones eficientes que optimizan la gestión de procesos.
        </p>

        <!-- CTA Buttons -->
        <div
          class="hero-reveal mt-9 flex flex-col justify-center gap-4 sm:flex-row lg:justify-start"
          style="--d: 360ms"
        >
          <a href="#contacto" class="btn btn-primary">
            Contáctame
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
          </a>
          <a href="/cv.pdf" class="btn btn-secondary">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" /><polyline points="7 10 12 15 17 10" /><line x1="12" x2="12" y1="15" y2="3" /></svg>
            Descargar CV
          </a>
        </div>
      </div>

      <!-- Abstract avatar illustration -->
      <div
        class="hero-reveal relative hidden justify-center lg:flex"
        style="--d: 480ms"
      >
        <div class="avatar-ring p-[3px]">
          <div class="flex size-72 items-center justify-center overflow-hidden rounded-full bg-surface shadow-[0_24px_60px_rgba(4,6,5,0.16)] dark:shadow-[0_24px_60px_rgba(0,0,0,0.4)]">
            <svg viewBox="0 0 200 200" class="avatar-figure size-full" aria-hidden="true">
              <circle cx="100" cy="86" r="44" fill="none" stroke="currentColor" stroke-width="1" opacity="0.14" />
              <circle cx="100" cy="86" r="30" fill="currentColor" opacity="0.14" />
              <ellipse cx="100" cy="152" rx="56" ry="34" fill="currentColor" opacity="0.08" />
              <circle cx="88" cy="80" r="3" fill="currentColor" opacity="0.5" />
              <circle cx="112" cy="80" r="3" fill="currentColor" opacity="0.5" />
              <path d="M90 98c6 5 14 5 20 0" stroke="currentColor" stroke-width="2" stroke-linecap="round" fill="none" opacity="0.35" />
            </svg>
          </div>
        </div>

        <!-- Floating code badge -->
        <div class="absolute -right-1 top-10 flex size-14 items-center justify-center rounded-2xl border border-border bg-surface text-primary shadow-[0_10px_30px_rgba(4,6,5,0.14)] dark:text-mint dark:shadow-[0_10px_30px_rgba(0,0,0,0.35)]">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6" /><polyline points="8 6 2 12 8 18" /></svg>
        </div>
      </div>
    </div>
  </div>
</section>
