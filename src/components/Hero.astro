              <circle cx="60" cy="45" r="18" fill="currentColor" opacity="0.15"/>
              <ellipse cx="60" cy="85" rx="32" ry="22" fill="currentColor" opacity="0.1"/>
              <circle cx="60" cy="45" r="3" fill="currentColor" opacity="0.4"/>
              <circle cx="60" cy="45" r="8" fill="none" stroke="currentColor" stroke-width="0.5" opacity="0.2"/>
            </svg>
          </div>
        </div>
        <div class="absolute -bottom-2 -right-2 w-12 h-12 rounded-full bg-gradient-to-br from-purple-600 to-pink-600 flex items-center justify-center shadow-lg">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21.2 15c.7-1.2 1-2.5 1-3.9 0-1.6-.4-3.1-1.1-4.4"/><path d="M2.8 15c-.7-1.2-1-2.5-1-3.9 0-1.6.4-3.1 1.1-4.4"/><path d="M17.5 7c.5-1.6.8-3.3.8-5"/><path d="M6.5 7c-.5-1.6-.8-3.3-.8-5"/><path d="M12 22v-7"/><path d="M9 12v4"/><path d="M15 12v4"/></svg>
        </div>
      </div>

      <!-- Text content -->
      <div class="flex-1 text-center md:text-left">
        <!-- Badge -->
        <div class="inline-flex items-center gap-2 rounded-full border border-border bg-background/60 backdrop-blur-sm px-4 py-1.5 text-sm mb-6">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-accent-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-green-accent-500"></span>
          </span>
          <span class="text-muted-foreground">Disponible para trabajar</span>
        </div>

        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight mb-6">
          Hola, soy <span class="gradient-text">Alejandro Yero</span>
        </h1>

        <p class="text-lg md:text-xl text-muted-foreground max-w-2xl mb-8 leading-relaxed">
          <strong class="text-foreground font-semibold">Ingeniero en Ciencias Informáticas</strong> full-stack con énfasis en frontend. 
          Más de 2 años diseñando soluciones eficientes que optimizan la gestión de procesos.
        </p>

        <!-- CTA Buttons -->
        <div class="flex flex-col sm:flex-row gap-4 justify-center md:justify-start">
          <a href="#contacto" class="inline-flex items-center justify-center h-11 px-6 rounded-lg bg-gradient-to-r from-purple-600 to-pink-600 text-white font-medium hover:opacity-90 transition-opacity">
            Contáctame
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="ml-2"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
          <a href="/cv.pdf" class="inline-flex items-center justify-center h-11 px-6 rounded-lg border border-border bg-background text-foreground font-medium hover:bg-accent transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg>
            Descargar CV
          </a>
        </div>
      </div>
    </div>
  </div>
</section>