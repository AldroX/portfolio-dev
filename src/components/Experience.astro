---
import ExperienceItems from "./ExperienceItems.astro";

const EXPERIENCIE = [
  {
    date: "Actualidad",
    title: "Puesto actual — reemplazá con tu título real",
    description:
      "Reemplazá este texto por una descripción breve de tu rol actual: responsabilidades, stack y logros medibles. Mantené el registro profesional en español.",
    link: "https://github.com/AldroX/task_flow",
  },
  {
    date: "Fecha de inicio — fin",
    title: "Experiencia anterior — reemplazá con tu título real",
    description:
      "Reemplazá este texto por una descripción breve de tu rol anterior: responsabilidades, stack y logros medibles. Mantené el registro profesional en español.",
    link: "",
  },

];
---

<div class="mt-20">
  {
    EXPERIENCIE.map((experience) => (
      <div class="mb-10 ms-4">
        <ExperienceItems {...experience} />
      </div>
    ))
  }
</div>
