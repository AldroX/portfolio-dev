---
import ExperienceItems from "./ExperienceItems.astro";

const EXPERIENCIE = [
  {
    date: "Enero 2024 – Actualidad",
    title: "Frontend Developer — FORTES",
    description:
      "Desarrollo y mantenimiento de funcionalidades para un sistema de gestión académica con Angular y TypeScript. Creo módulos y componentes reutilizables, implemento formularios y navegación, y consumo APIs REST de Django REST Framework. Trabajo con RxJS, NG-ZORRO, Git y GitLab.",
  },
  {
    date: "Junio 2023 – Diciembre 2023",
    title: "Full-Stack Developer — Proyecto de Integración, UCI",
    description:
      "Participé en el desarrollo de un componente para integrar plataformas académicas y administrativas. Colaboré en el análisis de requerimientos y la arquitectura, implementé la interfaz con Java y JavaFX, el backend con Python y Django REST Framework, y la persistencia con PostgreSQL. También diseñé y ejecuté pruebas de componente, integración y aceptación.",
  },
];
---

<div class="mt-20">
  {
    EXPERIENCIE.map((experience) => (
      <div class="mb-10 ms-4">
        <ExperienceItems {...experience} />
      </div>
    ))
  }
</div>
