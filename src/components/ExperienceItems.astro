---
interface Props {
  title: string;
  description: string;
  link?: string;
  date: string;
}
const { title, description, link, date } = Astro.props;
---

<div class="relative pl-8">
  <!-- Timeline rail -->
  <div
    class="absolute bottom-2 left-[5px] top-2 w-px bg-gradient-to-b from-primary/60 via-primary/20 to-transparent"
    aria-hidden="true"
  />
  <!-- Timeline dot -->
  <div class="absolute left-0 top-2 size-2.5 rounded-full bg-primary ring-4 ring-background-secondary dark:bg-mint" />

  <div class="card p-8">
    <time class="text-xs font-medium uppercase tracking-wide text-foreground-muted">{date}</time>
    <h3 class="mt-2.5 text-lg font-semibold text-foreground">{title}</h3>
    <p class="mt-2 text-sm leading-relaxed text-foreground-muted">{description}</p>
    {
      link && (
        <a
          href={link}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-4 inline-flex items-center gap-1.5 text-sm font-medium text-primary transition-colors hover:text-primary-hover dark:text-mint dark:hover:text-white"
        >
          Ver proyecto
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
        </a>
      )
    }
  </div>
</div>
