---
import Tailwind from '@icons/Tailwind.astro'
import Angular from '@icons/Angular.astro'
import Nestjs from '@icons/Nestjs.astro';
import PostgreSQL from '@icons/PostgreSQL.astro';
import Prisma from '@icons/Prisma.astro';
import Swagger from '@icons/Swagger.astro';

const SKILL = {
  ANGULAR: { name: "Angular", icon: Angular },
  TAILWIND: { name: "Tailwind", icon: Tailwind },
  NESTJS: { name: "Nestjs", icon: Nestjs },
  POSTGRESQL: { name:"Postgresql", icon: PostgreSQL },
  PRISMA: { name: "Prisma", icon: Prisma },
  SWAGGER: { name:"Swagger", icon: Swagger }
};

const PROJECTS = [
  {
    img: "/projects/mortyProject.webp",
    title: "App envíos",
    description: "App de gestión de envíos",
    skill: [SKILL.ANGULAR, SKILL.TAILWIND],
    links: "https://morty-app-ten.vercel.app/",
    gitHub: "https://github.com/AldroX/RickMorty.git",
  },
  {
    img: "/projects/todoApp.webp",
    title: "Todo App",
    description: "Gestión de tareas colaborativas",
    skill: [SKILL.ANGULAR, SKILL.NESTJS, SKILL.POSTGRESQL, SKILL.PRISMA, SKILL.SWAGGER],
    links: "https://morty-app-ten.vercel.app/",
    gitHub: "https://github.com/AldroX/RickMorty.git",
  },
];
---

<div class="grid grid-cols-1 md:grid-cols-2 gap-5">
  {
    PROJECTS.map(({ title, description, skill, img, links, gitHub }) => (
      <article class="group relative rounded-xl border border-border bg-card overflow-hidden hover:shadow-md transition-all duration-300">
        <!-- Thumbnail chico -->
        <div class="relative h-36 overflow-hidden">
          <img
            class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
            src={img}
            alt={title}
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/40 to-transparent" />
          
          <!-- Acciones flotantes -->
          <div class="absolute top-2 right-2 flex gap-1.5 opacity-0 group-hover:opacity-100 transition-opacity duration-200">
            <a href={links} target="_blank" rel="noopener noreferrer"
              class="bg-white/90 hover:bg-white text-gray-900 px-2.5 py-1 rounded-md text-xs font-medium backdrop-blur-sm transition-all hover:scale-105">
              Demo
            </a>
            <a href={gitHub} target="_blank" rel="noopener noreferrer"
              class="bg-gray-900/80 hover:bg-gray-900 text-white px-2.5 py-1 rounded-md text-xs font-medium backdrop-blur-sm transition-all hover:scale-105">
              GitHub
            </a>
          </div>
        </div>

        <!-- Body compacto -->
        <div class="p-4 space-y-3">
          <div class="flex items-start justify-between gap-2">
            <h3 class="font-semibold text-foreground text-sm leading-tight">{title}</h3>
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-muted-foreground shrink-0 mt-0.5 opacity-0 -translate-x-1 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-200"><path d="M7 7h10v10"/><path d="M7 17 17 7"/></svg>
          </div>
          <p class="text-xs text-muted-foreground leading-relaxed line-clamp-2">{description}</p>
          <div class="flex flex-wrap gap-1.5 pt-0.5">
            {skill.map((s) => (
              <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md text-[10px] font-medium bg-muted text-muted-foreground border border-border/50">
                <s.icon class="size-3" />
                {s.name}
              </span>
            ))}
          </div>
        </div>
      </article>
    ))
  }
</div>