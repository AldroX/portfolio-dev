---
import GitHub from "@icons/GitHub.astro";
import LinkedIn from "@icons/LinkedIn.astro";
import Mail from "@icons/Mails.astro";

const currentYear = new Date().getFullYear();
---

<footer>
  <!-- Contact Section -->
  <section id="contacto" class="py-20 md:py-32 bg-muted/30">
    <div class="max-w-6xl mx-auto px-4">
      <div class="text-center space-y-4 mb-16">
        <h2 class="text-3xl md:text-5xl font-bold">
          Trabajemos <span class="gradient-text">juntos</span>
        </h2>
        <p class="text-lg text-muted-foreground max-w-2xl mx-auto">
          ¿Tenés un proyecto en mente o querés conversar? Estoy abierto a oportunidades laborales y colaboraciones.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 max-w-4xl mx-auto">
        <!-- Contact Info -->
        <div class="space-y-8">
          <div class="space-y-6">
            <div class="flex items-center gap-4">
              <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-purple-600 to-pink-600 flex items-center justify-center shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
              </div>
              <div>
                <p class="text-sm text-muted-foreground">Email</p>
                <a href="mailto:alejandroyero925@gmail.com" class="font-medium hover:text-purple-500 transition-colors">alejandroyero925@gmail.com</a>
              </div>
            </div>

            <div class="flex items-center gap-4">
              <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-blue-600 to-cyan-600 flex items-center justify-center shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/></svg>
              </div>
              <div>
                <p class="text-sm text-muted-foreground">LinkedIn</p>
                <a href="https://www.linkedin.com/in/alejandro-yero-ba4056304/" target="_blank" rel="noopener noreferrer" class="font-medium hover:text-purple-500 transition-colors">Alejandro Yero</a>
              </div>
            </div>

            <div class="flex items-center gap-4">
              <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-gray-600 to-gray-800 flex items-center justify-center shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
              </div>
              <div>
                <p class="text-sm text-muted-foreground">GitHub</p>
                <a href="https://github.com/AldroX" target="_blank" rel="noopener noreferrer" class="font-medium hover:text-purple-500 transition-colors">@AldroX</a>
              </div>
            </div>
          </div>

          <!-- Download CV -->
          <a href="/cv.pdf" download class="inline-flex items-center gap-2 px-6 py-3 rounded-xl border-2 border-dashed border-purple-500/50 text-purple-500 hover:bg-purple-500/10 transition-colors group">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="group-hover:animate-bounce"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg>
            <span class="font-medium">Descargar CV</span>
          </a>
        </div>

        <!-- Contact Form -->
        <form class="space-y-5" action="https://formspree.io/f/your-form-id" method="POST">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <div>
              <label for="name" class="block text-sm font-medium mb-2">Nombre</label>
              <input type="text" id="name" name="name" required placeholder="Tu nombre" class="w-full h-11 px-4 rounded-lg border border-border bg-background text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-purple-500/50 transition-all" />
            </div>
            <div>
              <label for="email" class="block text-sm font-medium mb-2">Email</label>
              <input type="email" id="email" name="email" required placeholder="tu@email.com" class="w-full h-11 px-4 rounded-lg border border-border bg-background text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-purple-500/50 transition-all" />
            </div>
          </div>
          <div>
            <label for="message" class="block text-sm font-medium mb-2">Mensaje</label>
            <textarea id="message" name="message" required rows="4" placeholder="Contame sobre tu proyecto..." class="w-full px-4 py-3 rounded-lg border border-border bg-background text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-purple-500/50 transition-all resize-none"></textarea>
          </div>
          <button type="submit" class="w-full h-11 rounded-lg bg-gradient-to-r from-purple-600 to-pink-600 text-white font-medium hover:opacity-90 transition-opacity">
            Enviar mensaje
          </button>
        </form>
      </div>
    </div>
  </section>

  <!-- Footer Bottom -->
  <div class="border-t border-border">
    <div class="max-w-6xl mx-auto px-4 py-8 flex flex-col md:flex-row justify-between items-center gap-4">
      <div class="flex items-center gap-2">
        <div class="flex items-center justify-center w-6 h-6 rounded bg-gradient-to-br from-purple-500 to-pink-500">
          <span class="text-white font-bold text-xs">A</span>
        </div>
        <span class="font-bold gradient-text">alex.dev</span>
      </div>
      <p class="text-sm text-muted-foreground">
        © {currentYear} Alejandro Yero. Todos los derechos reservados.
      </p>
      <div class="flex gap-4">
        <a href="https://github.com/AldroX" target="_blank" rel="noopener noreferrer" class="text-muted-foreground hover:text-foreground transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
        </a>
        <a href="https://www.linkedin.com/in/alejandro-yero-ba4056304/" target="_blank" rel="noopener noreferrer" class="text-muted-foreground hover:text-foreground transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/></svg>
        </a>
      </div>
    </div>
  </div>
</footer>