---
const currentYear = new Date().getFullYear();
---

<footer>
  <!-- Contact Section -->
  <section id="contacto" class="py-24 md:py-32">
    <div class="mx-auto w-full max-w-6xl px-4 sm:px-6">
      <div class="mb-16 max-w-2xl" data-reveal>
        <h2 class="text-3xl font-semibold tracking-tight text-foreground md:text-4xl">
          Trabajemos juntos
        </h2>
        <p class="mt-4 text-lg leading-relaxed text-foreground-secondary">
          ¿Tenés un proyecto en mente o querés conversar? Estoy abierto a oportunidades laborales y colaboraciones.
        </p>
      </div>

      <div class="grid grid-cols-1 gap-12 md:grid-cols-2 md:gap-10" data-reveal>
        <!-- Contact Info -->
        <div class="space-y-8">
          <div class="space-y-6">
            <div class="flex items-center gap-4">
              <span class="flex size-12 shrink-0 items-center justify-center rounded-2xl border border-border bg-surface text-primary dark:text-mint">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2" /><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" /></svg>
              </span>
              <div>
                <p class="text-sm text-foreground-muted">Email</p>
                <a href="mailto:alejandroyero925@gmail.com" class="font-medium text-foreground transition-colors hover:text-primary dark:hover:text-mint">alejandroyero925@gmail.com</a>
              </div>
            </div>

            <div class="flex items-center gap-4">
              <span class="flex size-12 shrink-0 items-center justify-center rounded-2xl border border-border bg-surface text-primary dark:text-mint">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.79 19.79 0 0 1 2.12 4.2 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.12.96.36 1.9.7 2.8a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.84.58 2.8.7a2 2 0 0 1 1.73 2.03z" /></svg>
              </span>
              <div>
                <p class="text-sm text-foreground-muted">Teléfono</p>
                <a href="tel:+5359137704" class="font-medium text-foreground transition-colors hover:text-primary dark:hover:text-mint">+53 59137704</a>
              </div>
            </div>

            <div class="flex items-center gap-4">
              <span class="flex size-12 shrink-0 items-center justify-center rounded-2xl border border-border bg-surface text-primary dark:text-mint">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 5-8 12-8 12S4 15 4 10a8 8 0 1 1 16 0Z" /><circle cx="12" cy="10" r="2.5" /></svg>
              </span>
              <div>
                <p class="text-sm text-foreground-muted">Ubicación</p>
                <p class="font-medium text-foreground">La Habana, Cuba</p>
              </div>
            </div>

            <div class="flex items-center gap-4">
              <span class="flex size-12 shrink-0 items-center justify-center rounded-2xl border border-border bg-surface text-primary dark:text-mint">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z" /><rect width="4" height="12" x="2" y="9" /><circle cx="4" cy="4" r="2" /></svg>
              </span>
              <div>
                <p class="text-sm text-foreground-muted">LinkedIn</p>
                <a href="https://www.linkedin.com/in/alejandro-yero-ba4056304/" target="_blank" rel="noopener noreferrer" class="font-medium text-foreground transition-colors hover:text-primary dark:hover:text-mint">Alejandro Yero</a>
              </div>
            </div>

            <div class="flex items-center gap-4">
              <span class="flex size-12 shrink-0 items-center justify-center rounded-2xl border border-border bg-surface text-primary dark:text-mint">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4" /><path d="M9 18c-4.51 2-5-2-7-2" /></svg>
              </span>
              <div>
                <p class="text-sm text-foreground-muted">GitHub</p>
                <a href="https://github.com/AldroX" target="_blank" rel="noopener noreferrer" class="font-medium text-foreground transition-colors hover:text-primary dark:hover:text-mint">@AldroX</a>
              </div>
            </div>
          </div>

          <!-- Download CV -->
          <a href="/Alejeandro-Yero-FullStack-CV.pdf" download class="btn btn-secondary">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" /><polyline points="7 10 12 15 17 10" /><line x1="12" x2="12" y1="15" y2="3" /></svg>
            <span class="font-medium">Descargar CV</span>
          </a>
        </div>

        <div class="flex flex-col justify-center gap-5 border-t border-border pt-8 md:border-l md:border-t-0 md:pl-10 md:pt-0">
          <div>
            <h3 class="text-xl font-semibold text-foreground">¿Hablamos?</h3>
            <p class="mt-2 max-w-md leading-relaxed text-foreground-secondary">
              Para oportunidades laborales, colaboraciones o consultas, puedes escribirme directamente.
            </p>
          </div>
          <a href="mailto:alejandroyero925@gmail.com?subject=Contacto%20desde%20mi%20portfolio" class="btn btn-primary w-fit">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2" /><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" /></svg>
            Enviar correo
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Footer Bottom -->
  <div class="border-t border-border">
    <div class="mx-auto flex w-full max-w-6xl flex-col items-center justify-between gap-4 px-4 py-8 md:flex-row sm:px-6">
      <div class="flex items-center gap-2">
        <img src="/favicon.svg" alt="" aria-hidden="true" class="size-6" />
        <span class="font-semibold text-foreground">alex.dev</span>
      </div>
      <p class="text-sm text-foreground-muted">
        © {currentYear} Alejandro Yero. Todos los derechos reservados.
      </p>
      <div class="flex gap-4">
        <a href="https://github.com/AldroX" target="_blank" rel="noopener noreferrer" aria-label="GitHub" class="text-foreground-muted transition-colors hover:text-primary dark:hover:text-mint">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4" /><path d="M9 18c-4.51 2-5-2-7-2" /></svg>
        </a>
        <a href="https://www.linkedin.com/in/alejandro-yero-ba4056304/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="text-foreground-muted transition-colors hover:text-primary dark:hover:text-mint">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z" /><rect width="4" height="12" x="2" y="9" /><circle cx="4" cy="4" r="2" /></svg>
        </a>
      </div>
    </div>
  </div>
</footer>
