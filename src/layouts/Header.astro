---
import ThemeToggle from "@components/ThemeToggle.astro";
---

<header class="site-header sticky top-0 z-50 w-full">
  <nav class="mx-auto flex h-16 w-full max-w-6xl items-center justify-between px-4 sm:px-6">
    <!-- Logo -->
    <a href="/" class="flex items-center gap-2.5" aria-label="alex.dev — inicio">
      <img src="/favicon.svg" alt="" aria-hidden="true" class="size-8" />
      <span class="text-lg font-semibold tracking-tight text-foreground">
        alex.dev
      </span>
    </a>

    <!-- Desktop Navigation -->
    <div class="hidden items-center gap-8 md:flex">
      <a href="#sobre-mi" class="text-sm font-medium text-foreground-secondary transition-colors hover:text-foreground">Sobre mí</a>
      <a href="#experiencia" class="text-sm font-medium text-foreground-secondary transition-colors hover:text-foreground">Experiencia</a>
      <a href="#skills" class="text-sm font-medium text-foreground-secondary transition-colors hover:text-foreground">Skills</a>
      <a href="#proyectos" class="text-sm font-medium text-foreground-secondary transition-colors hover:text-foreground">Proyectos</a>
    </div>

    <!-- Actions -->
    <div class="flex items-center gap-3">
      <ThemeToggle class="flex size-9 items-center justify-center rounded-full border border-border text-foreground-secondary transition-colors hover:bg-surface hover:text-foreground" />
      <a href="#contacto" class="btn btn-primary btn-sm hidden md:inline-flex">
        Contacto
      </a>
    </div>
  </nav>
</header>

<script>
  (function () {
    const header = document.querySelector('.site-header');
    if (!header) return;
    const onScroll = () => {
      header.classList.toggle('scrolled', window.scrollY > 12);
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  })();
</script>
