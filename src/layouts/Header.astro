---
import ThemeToggle from "@components/ThemeToggle.astro";
---

<header class="sticky top-0 z-50 w-full border-b border-border bg-background/80 backdrop-blur-lg supports-[backdrop-filter]:bg-background/60">
  <nav class="max-w-6xl mx-auto flex h-16 items-center justify-between px-4">
    <!-- Logo -->
    <a href="/" class="flex items-center gap-2">
      <div class="flex items-center justify-center w-8 h-8 rounded-lg bg-gradient-to-br from-purple-500 to-pink-500">
        <span class="text-white font-bold text-sm">A</span>
      </div>
      <span class="font-bold text-xl gradient-text">
        alex.dev
      </span>
    </a>

    <!-- Desktop Navigation -->
    <div class="hidden md:flex items-center gap-8">
      <a href="#sobre-mi" class="text-sm font-medium text-muted-foreground hover:text-foreground transition-colors">Sobre mí</a>
      <a href="#experiencia" class="text-sm font-medium text-muted-foreground hover:text-foreground transition-colors">Experiencia</a>
      <a href="#skills" class="text-sm font-medium text-muted-foreground hover:text-foreground transition-colors">Skills</a>
      <a href="#proyectos" class="text-sm font-medium text-muted-foreground hover:text-foreground transition-colors">Proyectos</a>
    </div>

    <!-- Actions -->
    <div class="flex items-center gap-4">
      <ThemeToggle class="flex items-center justify-center w-9 h-9 rounded-full border border-border bg-background hover:bg-accent transition-colors" />
      <a href="#contacto" class="hidden md:inline-flex items-center justify-center h-9 px-4 rounded-md bg-gradient-to-r from-purple-600 to-pink-600 text-white text-sm font-medium hover:opacity-90 transition-opacity">
        Contacto
      </a>
    </div>
  </nav>
</header>